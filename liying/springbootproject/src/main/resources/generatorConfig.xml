<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">
<generatorConfiguration>
    <!-- MyBatis3Simple：只生成基础的增删改查，不生成Example类 -->
    <context id="mysql" targetRuntime="MyBatis3Simple">
        <!-- 不生成注释 -->
        <commentGenerator>
            <property name="suppressAllComments" value="true"/>
        </commentGenerator>
        <!-- 数据库连接 -->
        <jdbcConnection driverClass="com.mysql.cj.jdbc.Driver"
                        connectionURL="jdbc:mysql://localhost:3306/springbootdata?serverTimezone=UTC%2B8"
                        userId="root"
                        password="123456">
            <!-- 只读取当前库的表，避免读取到其他库的同名表 -->
            <property name="nullCatalogMeansCurrent" value="true"/>
        </jdbcConnection>
        <!-- 实体类的生成位置 -->
        <javaModelGenerator targetPackage="org.example.springclass.demos.web.pojo" targetProject="src/main/java"/>
        <!-- XML映射文件的生成位置 -->
        <sqlMapGenerator targetPackage="mapper" targetProject="src/main/resources"/>
        <!-- Mapper接口的生成位置 -->
        <javaClientGenerator type="XMLMAPPER" targetPackage="org.example.springclass.demos.web.mapper" targetProject="src/main/java"/>
        <!-- 要逆向生成的数据表 -->
        <table tableName="t_category" domainObjectName="Category">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="t_product" domainObjectName="Product">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
            <!-- TINYINT默认映射为Byte，这里改为Integer -->
            <columnOverride column="status" javaType="java.lang.Integer"/>
        </table>
    </context>
</generatorConfiguration>